{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "@/api-config": ["src/api-config.example.ts"],
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/pure.ts",
    "src/pure.test.ts",
    "src/api.ts",
    "src/api.test.ts",
    "src/api-config.example.ts",
    "src/notification-plan.ts",
    "src/notification-plan.test.ts",
    "src/export-fixtures.test.ts",
    "src/locales.test.ts",
    "src/i18n-plural.test.ts"
  ]
}
