# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
scripts/.tmdb-token

# secrets — never commit
.env

# TMDB API token — never commit
src/tmdb-token.ts

# local build outputs
build/
build-sim/
*.aab

# Trakt API credentials — never commit
src/trakt-keys.ts
# TheTVDB API key — never commit
src/tvdb-key.ts

# RevenueCat public SDK keys — see src/rc-keys.example.ts
src/rc-keys.ts

# community API base URL — local/prod differ, see src/api-config.example.ts
src/api-config.ts

# Google OAuth client ids — never commit, see src/auth-config.example.ts
src/auth-config.ts

# local device build output
build-device

# AI assistant configs — personal, not project files
CLAUDE.md
AGENTS.md
.claude/
.cursorrules
.windsurfrules
.github/copilot-instructions.md
INSTRUCTIONS.md

# planning docs — local only
*.plan.md
opentv-*.md

# secret backups — .env is ignored, its copies were not (a .env.bak was one
# `git add -A` away from a public repo)
.env.*
.env.bak*

# internal planning, handovers and design specs — written for one developer and
# an assistant, not for a reader of this repository
docs/
