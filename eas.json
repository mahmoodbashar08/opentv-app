{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true
    },
    "github": {
      "distribution": "internal",
      "android": { "buildType": "apk", "credentialsSource": "local" },
      "env": { "EXPO_PUBLIC_DISTRIBUTION": "github" }
    }
  },
  "submit": {
    "production": {}
  }
}
