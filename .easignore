# .easignore REPLACES .gitignore for EAS uploads. It mirrors .gitignore with
# one deliberate difference: the gitignored files the app cannot COMPILE
# without are uploaded anyway — src/tmdb-token.ts, src/tvdb-key.ts,
# src/rc-keys.ts and src/api-config.ts. EAS project uploads are private to
# this account.
#
# Adding one of those to the list below does not fail the build loudly. It
# produces an app that builds, installs, and cannot reach the thing that key
# was for — no metadata, or a paywall with no products.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# generated native folders — EAS prebuilds these itself
/ios
/android

# local xcodebuild outputs — ballooned uploads to 1.8 GB
build
build-sim

# Metro / debug / misc
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.tsbuildinfo
.kotlin/
*.orig.*

# secrets that the build does NOT need
scripts/.tmdb-token
.env
.env*.local
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# local AAB outputs
*.aab
OpenTV-*.aab
build-device
